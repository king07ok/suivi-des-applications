:80 {
	@prometheus path /prometheus /prometheus/*
	handle @prometheus {
		reverse_proxy prometheus:9090
	}

	@provisioner path /grafana /grafana/*
	handle @provisioner {
		forward_auth demo-app:8000 {
			uri /auth/grafana
			copy_headers X-WEBAUTH-USER
		}
		reverse_proxy grafana:3000
	}

	handle {
		reverse_proxy demo-app:8000
	}
}
