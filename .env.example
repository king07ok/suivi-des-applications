GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-before-starting
WEB_PORT=8080
PORTAL_SESSION_SECRET_KEY=generate-a-random-secret-before-starting
PORTAL_ADMIN_NAME=Administrateur
PORTAL_ADMIN_EMAIL=admin@entreprise.local
PORTAL_ADMIN_PASSWORD=replace-with-a-long-random-password

# SMTP optionnel : laissez SMTP_HOST vide pour désactiver les e-mails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_STARTTLS=true
PORTAL_PUBLIC_URL=http://localhost:8080

# Grafana Cloud Metrics: renseignez ces valeurs depuis l'assistant Hosted Prometheus metrics.
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USER=
GRAFANA_CLOUD_PROMETHEUS_TOKEN=

# Slack optionnel : URL d'un webhook entrant pour recevoir les alertes Prometheus.
# Gardez cette valeur uniquement dans votre fichier .env local.
SLACK_WEBHOOK_URL=
