          "refId": "A",
          "expr": "sum(rate(http_responseCodes_ok_total{job=\"jenkins\"}[5m])) + sum(rate(http_responseCodes_created_total{job=\"jenkins\"}[5m])) + sum(rate(http_responseCodes_noContent_total{job=\"jenkins\"}[5m])) + sum(rate(http_responseCodes_notModified_total{job=\"jenkins\"}[5m]))",
