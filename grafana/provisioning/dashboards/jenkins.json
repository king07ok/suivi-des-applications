        {
          "refId": "B",
          "expr": "sum(rate(http_responseCodes_badRequest_total{job=\"jenkins\"}[5m])) + sum(rate(http_responseCodes_forbidden_total{job=\"jenkins\"}[5m])) + sum(rate(http_responseCodes_notFound_total{job=\"jenkins\"}[5m]))",
          "legendFormat": "4xx"
        },
        {
          "refId": "C",
          "expr": "sum(rate(http_responseCodes_serverError_total{job=\"jenkins\"}[5m])) + sum(rate(http_responseCodes_serviceUnavailable_total{job=\"jenkins\"}[5m]))",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "reqps"
