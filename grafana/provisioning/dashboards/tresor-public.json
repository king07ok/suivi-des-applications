{
  "uid": "tresor-public-monitoring",
  "title": "Supervision Trésor Public",
  "description": "Séries Blackbox réellement collectées pour le Portail Trésor Public.",
  "tags": [
    "tresor-public",
    "disponibilite",
    "blackbox"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 9,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations et alertes",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Disponibilité",
      "description": "État de la sonde HTTP de la page de connexion.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"tresor-public\",service_name=\"tresor-public\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Indisponible",
                  "color": "red"
                },
                "1": {
                  "text": "Disponible",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Code HTTP",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_http_status_code{job=\"tresor-public\",service_name=\"tresor-public\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Temps de réponse",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{job=\"tresor-public\",service_name=\"tresor-public\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Temps de réponse HTTP",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{job=\"tresor-public\",service_name=\"tresor-public\"}",
          "legendFormat": "Durée totale"
        },
        {
          "refId": "B",
          "expr": "probe_http_duration_seconds{job=\"tresor-public\",service_name=\"tresor-public\"}",
          "legendFormat": "{{phase}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Taille de la réponse HTTP",
      "description": "Taille du contenu reçu par la sonde, en octets.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_http_content_length{job=\"tresor-public\"}",
          "legendFormat": "Contenu reçu"
        },
        {
          "refId": "B",
          "expr": "probe_http_uncompressed_body_length{job=\"tresor-public\"}",
          "legendFormat": "Corps décompressé"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Détails de la connexion",
      "description": "Redirections, SSL, versions HTTP et IP, et résultat des vérifications de contenu.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_http_redirects{job=\"tresor-public\"}",
          "legendFormat": "Redirections"
        },
        {
          "refId": "B",
          "expr": "probe_http_ssl{job=\"tresor-public\"}",
          "legendFormat": "HTTPS / SSL"
        },
        {
          "refId": "C",
          "expr": "probe_http_version{job=\"tresor-public\"}",
          "legendFormat": "Version HTTP"
        },
        {
          "refId": "D",
          "expr": "probe_ip_protocol{job=\"tresor-public\"}",
          "legendFormat": "Version IP"
        },
        {
          "refId": "E",
          "expr": "probe_failed_due_to_regex{job=\"tresor-public\"}",
          "legendFormat": "Échec de vérification"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name"
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Adresse de la cible",
      "description": "Empreinte de l’adresse IP résolue par Blackbox Exporter.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_ip_addr_hash{job=\"tresor-public\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Dernière modification HTTP",
      "description": "Horodatage Last-Modified renvoyé par le site.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_http_last_modified_timestamp_seconds{job=\"tresor-public\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "État et durée de collecte Prometheus",
      "description": "Métriques du scrape de la sonde Trésor Public, pas du serveur applicatif.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"tresor-public\"}",
          "legendFormat": "Scrape réussi"
        },
        {
          "refId": "B",
          "expr": "scrape_duration_seconds{job=\"tresor-public\"}",
          "legendFormat": "Durée du scrape"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name"
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Échantillons Prometheus par collecte",
      "description": "Nombre de séries reçues, conservées après relabeling et nouvellement créées par scrape.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "targets": [
        {
          "refId": "A",
          "expr": "scrape_samples_scraped{job=\"tresor-public\"}",
          "legendFormat": "Collectés"
        },
        {
          "refId": "B",
          "expr": "scrape_samples_post_metric_relabeling{job=\"tresor-public\"}",
          "legendFormat": "Après relabeling"
        },
        {
          "refId": "C",
          "expr": "scrape_series_added{job=\"tresor-public\"}",
          "legendFormat": "Nouvelles séries"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name"
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Disponibilité sur 24 h",
      "description": "Pourcentage des sondes HTTP réussies sur les dernières 24 heures.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 34
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * avg_over_time(probe_success{job=\"tresor-public\",service_name=\"tresor-public\"}[24h])",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Latence HTTP p95 sur 24 h",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 34
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, probe_duration_seconds{job=\"tresor-public\",service_name=\"tresor-public\"}[24h])",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Temps de résolution DNS",
      "description": "Durée mesurée par Blackbox Exporter pour résoudre le nom de la cible.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 42
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_dns_lookup_time_seconds{job=\"tresor-public\",service_name=\"tresor-public\"}",
          "legendFormat": "Résolution DNS"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
